{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check:dry": "tsc --noEmit && npx jscpd src/ --pattern \"**/*.ts\" --ignore \"**/*.test.ts\" --min-lines 6 --min-tokens 45 --threshold 5"
  },
  "devDependencies": {
    "jscpd": "^5.4.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  }
}
